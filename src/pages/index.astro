---
import { customAlphabet } from "nanoid";
import Parser from "rss-parser";
import dayjs from "dayjs";

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import LinkTable from "../components/LinkTable.astro";
import Milestones from "../components/Milestones.astro";
import Featured from "../components/Featured.astro";
import SocialList from "../components/SocialList.astro";

import { featured } from "../data/featured";


const nanoid = customAlphabet(
    "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",
    5
);

const fetchPosts = async (url: string) => {
    return await new Parser({ timeout: 120000 }).parseURL(url);
};

const posts = await fetchPosts("https://syntackle.com/feed.xml");
const items = posts.items.slice(0, 5);

items.sort((a, b) => {
    return a.pubDate
        ? new Date(b.pubDate as string).getTime() -
              new Date(a.pubDate as string).getTime()
        : new Date(b.isoDate as string).getTime() -
              new Date(a.isoDate as string).getTime();
});

const projects = [
    {
        id: nanoid(),
        title: "better",
        meta: "AI · GitHub Action",
        url: "https://github.com/murtuzaalisurti/better",
    },
    {
        id: nanoid(),
        title: "syntackle",
        meta: "Developer blog",
        url: "https://syntackle.com",
    },
    {
        id: nanoid(),
        title: "mbuffs",
        meta: "AI · Movie lists",
        url: "https://mbuffs.murtuzaalisurti.com",
    },
    {
        id: nanoid(),
        title: "back-to-top",
        meta: "Web Component",
        url: "https://www.npmjs.com/package/@murtuzaalisurti/back-to-top",
    },
    {
        id: nanoid(),
        title: "rssed",
        meta: "RSS feeds",
        url: "https://rssed.murtuzaalisurti.com",
    },
    {
        id: nanoid(),
        title: "wavy",
        meta: "Text Animation",
        url: "https://www.npmjs.com/package/@murtuzaalisurti/wavy",
    },
];

const postItems = items.map((post) => ({
    id: nanoid(),
    title: post.title as string,
    url: post.link,
    meta: dayjs(post.pubDate || post.isoDate).format("MMM YYYY"),
}));
---

<Layout title="Murtuzaali Surti">
    <main>
        <Header
            name="Murtuzaali Surti"
            role="Software Engineer"
            avatar="/assets/avatar.jpg"
        />

        <section class="bio">
            <p class="bio-lead">
                a software engineer, building <a href="https://syntackle.com"
                    >syntackle.com</a
                >
            </p>
            <p>
                i break and fix code, write a lot (wanna <a
                    href="https://syntackle.com/author/murtuzaalisurti/"
                    >join me</a
                >?) and have published articles on several publications
                including <a href="https://css-tricks.com/author/murtuzaalisurti/"
                    >css-tricks</a
                > and <a href="https://www.freecodecamp.org/news/author/murtuza/"
                    >freeCodeCamp</a
                >. you can find me developing my projects such as <a
                    href="https://rssed.murtuzaalisurti.com">rssed</a
                > and <a href="https://github.com/murtuzaalisurti/better">better</a
                >, or writing on my <a href="https://syntackle.com">blog</a>.
            </p>
            <!-- <p>
                you can find me coding on my projects such as <a
                    href="https://rssed.murtuzaalisurti.com">rssed</a
                > and <a href="https://github.com/murtuzaalisurti/better">better</a
                >, or writing on my <a href="https://syntackle.com">blog</a>.
            </p> -->
            <p>find me on your terminal:</p>
            <button
                type="button"
                class="command"
                data-copy="npx murtuzaalisurti"
                title="Click to copy"
            >
                <span class="command-text">npx murtuzaalisurti</span>
                <span class="command-hint">copy</span>
            </button>
        </section>

        <script>
            document
                .querySelectorAll<HTMLButtonElement>(".command[data-copy]")
                .forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        try {
                            await navigator.clipboard.writeText(
                                btn.dataset.copy || ""
                            );
                            const hint = btn.querySelector(".command-hint");
                            if (hint) {
                                const prev = hint.textContent;
                                hint.textContent = "copied";
                                setTimeout(() => (hint.textContent = prev), 1500);
                            }
                        } catch (e) {}
                    });
                });
        </script>

        <section class="section" id="projects">
            <span class="section-label">Projects</span>
            <LinkTable items={projects} />
        </section>

        <section class="section" id="experience">
            <Milestones
                list={[
                    {
                        year: 2026,
                        parts: [
                            "senior software engineer at ",
                            { text: "allata", href: "https://allata.com" },
                        ],
                    },
                    {
                        year: 2024,
                        parts: [
                            "won the ",
                            {
                                text: "ai hackathon",
                                href: "https://www.linkedin.com/posts/imriel-technology-solutions-private-limited_imriel-allata-aihackathon-activity-7249290910922924032-Mqgj",
                            },
                            " at imriel (allata)",
                        ],
                    },
                    {
                        year: 2023,
                        parts: [
                            "software engineer at ",
                            { text: "allata", href: "https://allata.com" },
                        ],
                    },
                    {
                        year: 2023,
                        parts: ["graduated in computer applications (bca)"],
                    },
                    {
                        year: 2023,
                        parts: ["joined allata as an intern"],
                    },
                    {
                        year: 2022,
                        parts: [
                            "started ",
                            { text: "syntackle", href: "https://syntackle.com" },
                            ", a developer blog",
                        ],
                    },
                    {
                        year: 2021,
                        parts: [
                            "spoke at ",
                            {
                                text: "hacktoberfest",
                                href: "https://www.linkedin.com/posts/murtuzaali-surti_hacktoberfest2021-activity-6857932326245023744-7M9_",
                            },
                            ", navrachana university",
                        ],
                    },
                    {
                        year: 2021,
                        parts: [
                            "technical writer for ",
                            { text: "draft.dev", href: "https://draft.dev" },
                        ],
                    },
                    {
                        year: 2021,
                        parts: [
                            "started writing for ",
                            {
                                text: "css-tricks",
                                href: "https://css-tricks.com/author/murtuzaalisurti/",
                            },
                        ],
                    },
                ]}
            />
        </section>

        <hr class="separator" />

        <section class="section" id="featured">
            <Featured list={featured.map((item) => ({ id: nanoid(), ...item }))} />
        </section>

        <section class="section" id="posts">
            <span class="section-label">Writing</span>
            <LinkTable items={postItems} />
        </section>

        <section class="section uses" id="uses">
            <span class="section-label">Uses</span>
            <p>What I use on a daily basis for software development 👇</p>
            <div class="category">
                <h4>Editor</h4>
                <p>
                    You guessed it right, it's VSCode! What I love about it
                    is the capability to be simple yet powerful at the same
                    time.
                </p>
            </div>
            <div class="category">
                <h4>Coding Agent</h4>
                <p>
                    Switching between OpenCode and Claude Code, but I prefer using open source models in OpenCode via <a href="https://opencode.ai/go?ref=7S25CWFETH">OpenCode Go</a>.
                </p>
            </div>
            <div class="category">
                <h4>Terminal</h4>
                <p>
                    When I'm on Windows, I use <em>bash</em> inside VSCode's integrated terminal for
                    the most part, or the new Windows Terminal. On a Mac, I prefer <a href="https://syntackle.com/blog/mac-setup-for-developers/#:~:text=2.-,Warp,-If%20you%20don%27t">Warp</a>, and sometimes go to the default zsh terminal with <a href="https://syntackle.com/blog/mac-setup-for-developers/#:~:text=1.-,Oh%20My%20Zsh,-True%20power%20of">oh-my-zsh</a> on top. I also tried <a href="https://soloterm.com/">Solo</a>, and it's great too.
                </p>
            </div>
            <div class="category">
                <h4>Themes</h4>
                <p>
                    For my editor, the award goes to <strong><em>One Dark Pro Darker</em></strong>&nbsp; for the most eye-pleasing color pallette. I also like the <strong><em>Dark Modern</em></strong>&nbsp; theme of VSCode.
                </p>
                <p>
                    For the windows terminal, I went for Oh My Posh's <a
                        href="https://github.com/JanDeDobbeleer/oh-my-posh/blob/main/themes/stelbent.minimal.omp.json"
                        >stelbent minimal</a
                    > theme. It's a pretty good theme displaying crucial information.
                </p>
                <p>
                    On MacOS' terminal, I prefer the <a href="https://github.com/romkatv/powerlevel10k">powerlevel10k</a> theme of oh-my-zsh.
                </p>
            </div>
            <div class="category">
                <h4>Fonts</h4>
                <p>
                    Personally I love Apple's SF Mono font, so I found a <a
                        href="https://github.com/epk/SF-Mono-Nerd-Font"
                        >nerd font</a
                    > for windows which is the patched SF Mono font.
                </p>
                <p>
                    JetBrains Mono takes the second place. I was using it
                    for a long time before switching to SF Mono and by far
                    it's the most compact monospace font I have ever used.
                </p>
            </div>
        </section>

        <section class="section" id="contact">
            <span class="section-label">Contact</span>
            <p>
                Don't hesitate! Feel free to reach out to <a
                    title="hey@murtuzaalisurti.com"
                    href="mailto:hey@murtuzaalisurti.com">me</a
                >. If you are up for a quick chat, <a
                    data-cal-link="murtuzaalisurti/15min"
                    data-cal-namespace="15min"
                    data-cal-config='{"layout":"month_view"}'
                    >book your slot</a
                > on my calendar. I also run a blog, so if you are interested
                in writing anything about web technologies, then <a
                    href="https://syntackle.com/write/">pitch your ideas</a
                >!
            </p>
        </section>

        <section class="section" id="socials">
            <span class="section-label">Socials</span>
            <SocialList
                list={[
                    {
                        text: "GitHub",
                        link: "https://github.com/murtuzaalisurti",
                    },
                    {
                        text: "Twitter (X)",
                        link: "https://twitter.com/@murtuza_surti",
                    },
                    {
                        text: "LinkedIn",
                        link: "https://linkedin.com/in/murtuzaali-surti/",
                    },
                    {
                        text: "Mastodon",
                        link: "https://mastodon.social/@murtuzaalisurti",
                    },
                ]}
            />
        </section>
    </main>
</Layout>
