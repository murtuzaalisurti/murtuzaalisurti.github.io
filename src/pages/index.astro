                            },
                            {
                                id: nanoid(),
                                link: "https://css-tricks.com/author/murtuzaalisurti/",
                            },
                        ],
                    },
                    {
                        id: nanoid(),
                        title: "Technical Writer - Draft",
                        role: ["Freelance Content Writer."],
                        company: "draft",
                        link: "https://draft.dev",
