                    {
                        id: nanoid(),
                        title: "Content Creator - Aviyel",
                        role: [
                            "Gave a virtual talk and got featured in Coffee & Code event organized by Aviyel.",
                        ],
                        company: "aviyel",
                        link: "https://aviyel.com/@murtuzaalisurti",
                        startDate: "10/21",
                        endDate: "01/23",
                        showcase: [
                            {
                                id: nanoid(),
