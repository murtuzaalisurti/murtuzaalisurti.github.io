---
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import path from "node:path";
import Layout from "../layouts/Layout.astro";

// The PDF is generated from resume/resume.tex at build time
// (see scripts/build-resume.mjs) and served via src/pages/resume.pdf.ts.
// We append a content hash so browsers (especially mobile, which cache PDFs
// aggressively) fetch the new file whenever the resume changes, instead of
// serving a stale cached copy of the constant /resume.pdf URL.
const pdfPath = path.join(process.cwd(), "public", "resume-murtuzaali-surti.pdf");
const version = createHash("sha256").update(readFileSync(pdfPath)).digest("hex").slice(0, 8);
const pdfUrl = `/resume.pdf?v=${version}`;
---

<Layout title="Resume — Murtuzaali Surti">
    <main id="resume">
        <object class="resume-viewer" data={pdfUrl} type="application/pdf">
            <iframe class="resume-viewer" src={pdfUrl} title="Resume PDF"></iframe>
            <p class="resume-fallback">
                <a href={pdfUrl}>Open the resume</a>
            </p>
        </object>
    </main>
</Layout>

<style>
    #resume {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.25rem 3rem;
    }

    .resume-viewer {
        width: 100%;
        height: 90vh;
        min-height: 600px;
        border: 1px solid rgba(128, 128, 128, 0.35);
        border-radius: 6px;
    }

    .resume-fallback {
        padding: 1rem;
    }
</style>
